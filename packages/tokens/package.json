{
  "name": "@firdawsi/tokens",
  "version": "0.2.0",
  "description": "Platform-neutral design tokens for Firdawsi",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "generated",
    "src/tokens.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./generated/tokens.css",
    "./tokens.json": "./src/tokens.json",
    "./resolved.json": "./generated/tokens.json"
  },
  "scripts": {
    "generate": "node ./scripts/build.mjs",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "test": "node --test ./tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
