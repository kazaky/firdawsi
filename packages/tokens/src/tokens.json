{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Firdawsi v2 canonical tokens. Andalusi-first: the default surface family is warm lime plaster (yeso) and all proportional steps derive from the octagonal sebka ratios. Regional profiles are deviations from this default, not peers of it.",
  "color": {
    "$type": "color",
    "primitive": {
      "yeso": {
        "$description": "Carved lime-plaster neutrals. Independently constructed warm neutral ramp; the Andalusi-default surface family. Not sampled from any specific object.",
        "0": { "$value": "#fffdf9" },
        "50": { "$value": "#faf6ee" },
        "100": { "$value": "#f2ece0" },
        "200": { "$value": "#e7dfd0" },
        "300": { "$value": "#d5cab6" },
        "500": { "$value": "#a89b83" },
        "700": { "$value": "#6b6151" },
        "900": { "$value": "#2e2a22" }
      },
      "ink": {
        "$description": "Cool neutral ramp for text and dark-theme surfaces.",
        "0": { "$value": "#ffffff" },
        "50": { "$value": "#f7f8f7" },
        "100": { "$value": "#e8ebe9" },
        "300": { "$value": "#aeb7b2" },
        "500": { "$value": "#66736d" },
        "700": { "$value": "#35423c" },
        "900": { "$value": "#15201b" },
        "950": { "$value": "#0a110e" }
      },
      "jade": {
        "$description": "Green-glaze family. Primary role colour.",
        "50": { "$value": "#edf8f4" },
        "100": { "$value": "#d4eee5" },
        "200": { "$value": "#b6e0d0" },
        "300": { "$value": "#83c7ae" },
        "500": { "$value": "#2d8b6e" },
        "600": { "$value": "#206f58" },
        "700": { "$value": "#195847" },
        "800": { "$value": "#14463a" },
        "900": { "$value": "#12392f" }
      },
      "azure": {
        "$description": "Cobalt-glaze family. Secondary role colour.",
        "50": { "$value": "#eef7fb" },
        "100": { "$value": "#d5ecf5" },
        "300": { "$value": "#8fc9df" },
        "500": { "$value": "#378aac" },
        "700": { "$value": "#245d78" },
        "800": { "$value": "#1d4a60" },
        "900": { "$value": "#17394a" }
      },
      "saffron": {
        "$description": "Honey and amber family. Tertiary role colour.",
        "50": { "$value": "#fff8e8" },
        "100": { "$value": "#fdeec6" },
        "200": { "$value": "#f8dda0" },
        "400": { "$value": "#dda83a" },
        "600": { "$value": "#a66d12" },
        "700": { "$value": "#855610" },
        "800": { "$value": "#68420e" }
      },
      "clay": {
        "$description": "Terracotta and manganese family. Error role colour.",
        "50": { "$value": "#fff3ef" },
        "100": { "$value": "#ffe1d8" },
        "300": { "$value": "#eaa38e" },
        "500": { "$value": "#bd6048" },
        "700": { "$value": "#843d2e" },
        "800": { "$value": "#663026" },
        "900": { "$value": "#4f271f" }
      },
      "transparent": { "$value": "#00000000" }
    }
  },
  "sebka": {
    "$description": "The proportional system. Andalusi and Nasrid surface geometry is overwhelmingly 8- and 16-fold, which yields two governing constants: the octagon ratio root-2 and the silver ratio 1+root-2. Every named step below is base 16 multiplied by 2^(n/4), so every second step is exactly root-2 apart and every fourth step is exactly an octave. Type, radii, and control sizes are drawn from these steps; spacing is snapped to the 4px base unit that spec/04 requires.",
    "ratio": {
      "$type": "number",
      "octagon": {
        "$description": "root-2. The octagon's defining ratio; one micro step squared.",
        "$value": 1.41421356
      },
      "silver": {
        "$description": "1+root-2. Governs sebka net subdivision; used for display-scale jumps.",
        "$value": 2.41421356
      },
      "step": {
        "$description": "2^(1/4). One sebka micro step. Two steps make an octagon ratio, four make an octave.",
        "$value": 1.18920712
      }
    },
    "step": {
      "$type": "dimension",
      "-2": { "$value": { "value": 11.5, "unit": "px" } },
      "-1": { "$value": { "value": 13.5, "unit": "px" } },
      "0": { "$value": { "value": 16, "unit": "px" } },
      "1": { "$value": { "value": 19, "unit": "px" } },
      "2": { "$value": { "value": 22.5, "unit": "px" } },
      "3": { "$value": { "value": 27, "unit": "px" } },
      "4": { "$value": { "value": 32, "unit": "px" } },
      "5": { "$value": { "value": 38, "unit": "px" } },
      "6": { "$value": { "value": 45, "unit": "px" } },
      "7": { "$value": { "value": 54, "unit": "px" } },
      "8": { "$value": { "value": 64, "unit": "px" } }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing keeps the 4px base unit required by spec/04. Named steps approximate a root-2 progression snapped to that grid, so each adjacent pair multiplies to roughly an octave.",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "0-5": { "$value": { "value": 2, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "1-5": { "$value": { "value": 6, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "20": { "$value": { "value": 80, "unit": "px" } },
    "24": { "$value": { "value": 96, "unit": "px" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Noto Sans", "Noto Sans Arabic", "system-ui", "sans-serif"] },
      "display": { "$value": ["El Messiri", "Noto Kufi Arabic", "Noto Sans Arabic", "system-ui", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "$description": "Legacy t-shirt scale, re-derived onto sebka steps. Prefer font.role.* for new work.",
      "xs": { "$value": "{sebka.step.-2}" },
      "sm": { "$value": "{sebka.step.-1}" },
      "md": { "$value": "{sebka.step.0}" },
      "lg": { "$value": "{sebka.step.1}" },
      "xl": { "$value": "{sebka.step.2}" },
      "2xl": { "$value": "{sebka.step.3}" },
      "3xl": { "$value": "{sebka.step.5}" },
      "4xl": { "$value": "{sebka.step.6}" },
      "5xl": { "$value": "{sebka.step.8}" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "display": { "$value": 1.3 },
      "body": { "$value": 1.6 },
      "arabic": { "$value": 1.85 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": { "value": -0.02, "unit": "rem" } },
      "normal": { "$value": { "value": 0, "unit": "rem" } },
      "wide": { "$value": { "value": 0.04, "unit": "rem" } },
      "arabic": {
        "$description": "Arabic is never letter-spaced; tracking would break cursive joining. This token exists so the rule is enforceable rather than remembered.",
        "$value": { "value": 0, "unit": "rem" }
      }
    },
    "role": {
      "$description": "Dual-optical type roles. Arabic and Latin are co-equal scripts, not a font and its fallback: each role carries an independent Arabic optical size and line height because Arabic at the same nominal size reads smaller and needs more leading.",
      "display-lg": {
        "size": { "$type": "dimension", "$value": "{sebka.step.8}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 66.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.08 },
        "line-height-arabic": { "$type": "number", "$value": 1.5 },
        "weight": { "$type": "fontWeight", "$value": 600 },
        "tracking": { "$type": "dimension", "$value": { "value": -0.02, "unit": "rem" } }
      },
      "display-md": {
        "size": { "$type": "dimension", "$value": "{sebka.step.7}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 56, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.1 },
        "line-height-arabic": { "$type": "number", "$value": 1.5 },
        "weight": { "$type": "fontWeight", "$value": 600 },
        "tracking": { "$type": "dimension", "$value": { "value": -0.02, "unit": "rem" } }
      },
      "display-sm": {
        "size": { "$type": "dimension", "$value": "{sebka.step.6}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 47, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.12 },
        "line-height-arabic": { "$type": "number", "$value": 1.52 },
        "weight": { "$type": "fontWeight", "$value": 600 },
        "tracking": { "$type": "dimension", "$value": { "value": -0.02, "unit": "rem" } }
      },
      "headline-lg": {
        "size": { "$type": "dimension", "$value": "{sebka.step.5}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 39.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.18 },
        "line-height-arabic": { "$type": "number", "$value": 1.6 },
        "weight": { "$type": "fontWeight", "$value": 600 },
        "tracking": { "$type": "dimension", "$value": { "value": -0.01, "unit": "rem" } }
      },
      "headline-md": {
        "size": { "$type": "dimension", "$value": "{sebka.step.4}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 33.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.2 },
        "line-height-arabic": { "$type": "number", "$value": 1.6 },
        "weight": { "$type": "fontWeight", "$value": 600 },
        "tracking": { "$type": "dimension", "$value": { "value": -0.01, "unit": "rem" } }
      },
      "headline-sm": {
        "size": { "$type": "dimension", "$value": "{sebka.step.3}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.24 },
        "line-height-arabic": { "$type": "number", "$value": 1.62 },
        "weight": { "$type": "fontWeight", "$value": 600 },
        "tracking": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
      },
      "title-lg": {
        "size": { "$type": "dimension", "$value": "{sebka.step.2}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 24.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.3 },
        "line-height-arabic": { "$type": "number", "$value": 1.7 },
        "weight": { "$type": "fontWeight", "$value": 600 },
        "tracking": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
      },
      "title-md": {
        "size": { "$type": "dimension", "$value": "{sebka.step.1}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 20.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.34 },
        "line-height-arabic": { "$type": "number", "$value": 1.72 },
        "weight": { "$type": "fontWeight", "$value": 600 },
        "tracking": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
      },
      "title-sm": {
        "size": { "$type": "dimension", "$value": "{sebka.step.0}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 17.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.4 },
        "line-height-arabic": { "$type": "number", "$value": 1.75 },
        "weight": { "$type": "fontWeight", "$value": 600 },
        "tracking": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
      },
      "body-lg": {
        "size": { "$type": "dimension", "$value": "{sebka.step.1}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 20.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.6 },
        "line-height-arabic": { "$type": "number", "$value": 1.85 },
        "weight": { "$type": "fontWeight", "$value": 400 },
        "tracking": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
      },
      "body-md": {
        "size": { "$type": "dimension", "$value": "{sebka.step.0}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 17.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.6 },
        "line-height-arabic": { "$type": "number", "$value": 1.85 },
        "weight": { "$type": "fontWeight", "$value": 400 },
        "tracking": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
      },
      "body-sm": {
        "size": { "$type": "dimension", "$value": "{sebka.step.-1}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 14.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.55 },
        "line-height-arabic": { "$type": "number", "$value": 1.8 },
        "weight": { "$type": "fontWeight", "$value": 400 },
        "tracking": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
      },
      "label-lg": {
        "size": { "$type": "dimension", "$value": "{sebka.step.0}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 17.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.4 },
        "line-height-arabic": { "$type": "number", "$value": 1.7 },
        "weight": { "$type": "fontWeight", "$value": 600 },
        "tracking": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
      },
      "label-md": {
        "size": { "$type": "dimension", "$value": "{sebka.step.-1}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 14.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.4 },
        "line-height-arabic": { "$type": "number", "$value": 1.7 },
        "weight": { "$type": "fontWeight", "$value": 500 },
        "tracking": { "$type": "dimension", "$value": { "value": 0.02, "unit": "rem" } }
      },
      "label-sm": {
        "size": { "$type": "dimension", "$value": "{sebka.step.-2}" },
        "size-arabic": { "$type": "dimension", "$value": { "value": 12.5, "unit": "px" } },
        "line-height": { "$type": "number", "$value": 1.36 },
        "line-height-arabic": { "$type": "number", "$value": 1.66 },
        "weight": { "$type": "fontWeight", "$value": 500 },
        "tracking": { "$type": "dimension", "$value": { "value": 0.04, "unit": "rem" } }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Sebka-derived corner radii: 4px times successive octagon ratios.",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 11, "unit": "px" } },
    "xl": { "$value": { "value": 16, "unit": "px" } },
    "2xl": { "$value": { "value": 23, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "shape": {
    "facet": {
      "$type": "dimension",
      "subtle": { "$value": { "value": 4, "unit": "px" } },
      "medium": { "$value": { "value": 8, "unit": "px" } },
      "bold": { "$value": { "value": 14, "unit": "px" } }
    },
    "arch": {
      "$description": "Arch construction ratios, expressed as fractions of the container's shorter edge. These drive the parametric corner family in @firdawsi/shape. Per spec/05 these are construction ratios, never a literal horseshoe silhouette used as a generic control shape.",
      "rise": {
        "$type": "number",
        "none": { "$value": 0 },
        "shallow": { "$value": 0.18 },
        "balanced": { "$value": 0.32 },
        "tall": { "$value": 0.5 }
      },
      "shoulder": {
        "$type": "number",
        "narrow": { "$value": 0.22 },
        "standard": { "$value": 0.34 },
        "wide": { "$value": 0.44 }
      },
      "morph": {
        "$type": "number",
        "$description": "State multipliers applied to rise. Corners interpolate between these on interaction; this is the Firdawsi counterpart to shape morphing.",
        "rest": { "$value": 1 },
        "hover": { "$value": 1.08 },
        "pressed": { "$value": 0.86 },
        "selected": { "$value": 1.12 },
        "expanded": { "$value": 1.18 }
      }
    },
    "corner": {
      "$type": "string",
      "rounded": { "$value": "round" },
      "faceted": { "$value": "bevel" },
      "notched": { "$value": "notch" },
      "arch": { "$value": "arch" }
    },
    "container": {
      "$type": "dimension",
      "xs": { "$value": "{radius.xs}" },
      "sm": { "$value": "{radius.sm}" },
      "md": { "$value": "{radius.md}" },
      "lg": { "$value": "{radius.lg}" },
      "xl": { "$value": "{radius.xl}" },
      "2xl": { "$value": "{radius.2xl}" }
    }
  },
  "focus": {
    "$description": "Strapwork focus indicator. Drawn as the two-stroke band the geometry engine already uses for interlace: an outer gap that separates the indicator from the control, and an inner core that carries the contrast. Functional, not ornamental, so it is permitted on every component.",
    "strap": {
      "$type": "dimension",
      "gap": { "$value": { "value": 2, "unit": "px" } },
      "core": { "$value": { "value": 2.5, "unit": "px" } },
      "offset": { "$value": { "value": 1, "unit": "px" } }
    }
  },
  "stroke": {
    "width": {
      "$type": "dimension",
      "hairline": { "$value": { "value": 1, "unit": "px" } },
      "regular": { "$value": { "value": 1.5, "unit": "px" } },
      "strong": { "$value": { "value": 2, "unit": "px" } },
      "ornamental": { "$value": { "value": 3, "unit": "px" } }
    },
    "dash": {
      "$type": "string",
      "none": { "$value": "none" },
      "measured": { "$value": "4 4" },
      "decorative": { "$value": "1 5" }
    }
  },
  "elevation": {
    "$type": "shadow",
    "$description": "Legacy blurred shadows, retained only for overlays that leave the document plane (menus, dialogs, toasts). Surfaces in the document plane use surface tiers instead.",
    "0": { "$value": { "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" } },
    "1": { "$value": { "color": "#2e2a2214", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" } },
    "2": { "$value": { "color": "#2e2a221f", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px" } },
    "3": { "$value": { "color": "#2e2a2229", "offsetX": "0px", "offsetY": "12px", "blur": "28px", "spread": "-6px" } }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.42 },
    "muted": { "$value": 0.64 },
    "scrim": { "$value": 0.58 },
    "pattern": { "$value": 0.09 },
    "full": { "$value": 1 }
  },
  "state": {
    "$type": "number",
    "$description": "State layer opacities, composited over the role colour of the underlying component.",
    "hover": { "$value": 0.08 },
    "focus": { "$value": 0.12 },
    "pressed": { "$value": 0.14 },
    "dragged": { "$value": 0.16 },
    "selected": { "$value": 0.12 },
    "disabled-content": { "$value": 0.38 },
    "disabled-container": { "$value": 0.12 }
  },
  "gradient": {
    "$type": "string",
    "courtyard-wash": {
      "$value": "radial-gradient(120% 90% at 12% 8%, #faf6ee 0%, #f2ece0 42%, #d4eee5 100%)"
    },
    "lapis-veil": {
      "$value": "linear-gradient(155deg, #eef7fb 0%, #d4eee5 48%, #8fc9df 100%)"
    },
    "jade-depth": {
      "$value": "radial-gradient(90% 70% at 80% 20%, #83c7ae 0%, #206f58 55%, #12392f 100%)"
    }
  },
  "pattern": {
    "density": {
      "$type": "number",
      "$description": "Jali perforation density. The only decorative axis in the system, permitted solely in the ornament zones spec/08 allows.",
      "none": { "$value": 0 },
      "quiet": { "$value": 0.35 },
      "balanced": { "$value": 0.6 },
      "rich": { "$value": 0.85 }
    },
    "cell": {
      "$type": "dimension",
      "sm": { "$value": { "value": 16, "unit": "px" } },
      "md": { "$value": { "value": 28, "unit": "px" } },
      "lg": { "$value": { "value": 44, "unit": "px" } }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": { "value": 0, "unit": "ms" } },
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "normal": { "$value": { "value": 220, "unit": "ms" } },
      "slow": { "$value": { "value": 360, "unit": "ms" } },
      "ceremonial": { "$value": { "value": 600, "unit": "ms" } }
    },
    "stage": {
      "$type": "duration",
      "$description": "Semantic timing for the Firdawsi interaction cycle. Stage names describe experience, not animation requirements; reduced-motion contexts may resolve every stage instantly.",
      "sukun": { "$value": "{motion.duration.instant}" },
      "dunu": { "$value": "{motion.duration.fast}" },
      "istijabah": { "$value": "{motion.duration.fast}" },
      "jarayan": { "$value": "{motion.duration.normal}" },
      "istiqrar": { "$value": "{motion.duration.slow}" },
      "salam": { "$value": "{motion.duration.normal}" }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Cubic-bezier approximations of the Alberca springs below, for CSS transitions that cannot run a spring solver.",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0.16, 1, 0.3, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] },
      "emphasis": { "$value": [0.22, 1, 0.36, 1] }
    },
    "spring": {
      "$description": "Alberca motion. Modelled on the surface of a courtyard reflecting pool: a fast rise followed by a long, low-amplitude settle. Damping ratios stay at or below 1 but high enough that overshoot is felt rather than seen, which is what spec/07 requires. Damping ratio is damping / (2 * sqrt(stiffness * mass)).",
      "snap": {
        "$description": "Small state changes: checkboxes, switches, focus. Near-critically damped, ratio about 0.95.",
        "stiffness": { "$type": "number", "$value": 340 },
        "damping": { "$type": "number", "$value": 35 },
        "mass": { "$type": "number", "$value": 1 }
      },
      "settle": {
        "$description": "The signature spring. Buttons, corner morphs, surface tier changes. Ratio about 0.78.",
        "stiffness": { "$type": "number", "$value": 220 },
        "damping": { "$type": "number", "$value": 23 },
        "mass": { "$type": "number", "$value": 1 }
      },
      "ripple": {
        "$description": "Expressive entrances: dialogs, sheets, expanding surfaces. Ratio about 0.63.",
        "stiffness": { "$type": "number", "$value": 160 },
        "damping": { "$type": "number", "$value": 16 },
        "mass": { "$type": "number", "$value": 1 }
      },
      "calm": {
        "$description": "Large surfaces and anything that must not overshoot. Critically damped, ratio 1.",
        "stiffness": { "$type": "number", "$value": 120 },
        "damping": { "$type": "number", "$value": 22 },
        "mass": { "$type": "number", "$value": 1 }
      }
    }
