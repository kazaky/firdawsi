{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "primitive": {
      "ink": {
        "0": { "$value": "#ffffff" },
        "50": { "$value": "#f7f8f7" },
        "100": { "$value": "#e8ebe9" },
        "300": { "$value": "#aeb7b2" },
        "500": { "$value": "#66736d" },
        "700": { "$value": "#35423c" },
        "900": { "$value": "#15201b" },
        "950": { "$value": "#0a110e" }
      },
      "jade": {
        "50": { "$value": "#edf8f4" },
        "100": { "$value": "#d4eee5" },
        "300": { "$value": "#83c7ae" },
        "500": { "$value": "#2d8b6e" },
        "600": { "$value": "#206f58" },
        "700": { "$value": "#195847" },
        "900": { "$value": "#12392f" }
      },
      "saffron": {
        "50": { "$value": "#fff8e8" },
        "200": { "$value": "#f8dda0" },
        "400": { "$value": "#dda83a" },
        "600": { "$value": "#a66d12" },
        "800": { "$value": "#68420e" }
      },
      "azure": {
        "50": { "$value": "#eef7fb" },
        "300": { "$value": "#8fc9df" },
        "500": { "$value": "#378aac" },
        "700": { "$value": "#245d78" },
        "900": { "$value": "#17394a" }
      },
      "clay": {
        "50": { "$value": "#fff3ef" },
        "300": { "$value": "#eaa38e" },
        "500": { "$value": "#bd6048" },
        "700": { "$value": "#843d2e" },
        "900": { "$value": "#4f271f" }
      },
      "transparent": { "$value": "#00000000" }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "0-5": { "$value": { "value": 2, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "1-5": { "$value": { "value": 6, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "20": { "$value": { "value": 80, "unit": "px" } },
    "24": { "$value": { "value": 96, "unit": "px" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Noto Sans", "Noto Sans Arabic", "system-ui", "sans-serif"] },
      "display": { "$value": ["Noto Kufi Arabic", "Noto Sans Arabic", "system-ui", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": { "value": 12, "unit": "px" } },
      "sm": { "$value": { "value": 14, "unit": "px" } },
      "md": { "$value": { "value": 16, "unit": "px" } },
      "lg": { "$value": { "value": 18, "unit": "px" } },
      "xl": { "$value": { "value": 22, "unit": "px" } },
      "2xl": { "$value": { "value": 28, "unit": "px" } },
      "3xl": { "$value": { "value": 36, "unit": "px" } },
      "4xl": { "$value": { "value": 48, "unit": "px" } },
      "5xl": { "$value": { "value": 64, "unit": "px" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "display": { "$value": 1.3 },
      "body": { "$value": 1.6 },
      "arabic": { "$value": 1.85 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": { "value": -0.02, "unit": "rem" } },
      "normal": { "$value": { "value": 0, "unit": "rem" } },
      "wide": { "$value": { "value": 0.04, "unit": "rem" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 14, "unit": "px" } },
    "xl": { "$value": { "value": 22, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "shape": {
    "facet": {
      "$type": "dimension",
      "subtle": { "$value": { "value": 4, "unit": "px" } },
      "medium": { "$value": { "value": 8, "unit": "px" } },
      "bold": { "$value": { "value": 14, "unit": "px" } }
    },
    "arch": {
      "rise": {
        "$type": "number",
        "shallow": { "$value": 0.18 },
        "balanced": { "$value": 0.32 },
        "tall": { "$value": 0.5 }
      },
      "shoulder": {
        "$type": "number",
        "narrow": { "$value": 0.22 },
        "standard": { "$value": 0.34 },
        "wide": { "$value": 0.44 }
      }
    },
    "corner": {
      "$type": "string",
      "rounded": { "$value": "round" },
      "faceted": { "$value": "bevel" },
      "notched": { "$value": "notch" },
      "arch": { "$value": "arch" }
    },
    "container": {
      "$type": "dimension",
      "sm": { "$value": "{radius.sm}" },
      "md": { "$value": "{radius.md}" },
      "lg": { "$value": "{radius.lg}" },
      "xl": { "$value": "{radius.xl}" }
    }
  },
  "stroke": {
    "width": {
      "$type": "dimension",
      "hairline": { "$value": { "value": 1, "unit": "px" } },
      "regular": { "$value": { "value": 1.5, "unit": "px" } },
      "strong": { "$value": { "value": 2, "unit": "px" } },
      "ornamental": { "$value": { "value": 3, "unit": "px" } }
    },
    "dash": {
      "$type": "string",
      "none": { "$value": "none" },
      "measured": { "$value": "4 4" },
      "decorative": { "$value": "1 5" }
    }
  },
  "elevation": {
    "$type": "shadow",
    "0": { "$value": { "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" } },
    "1": { "$value": { "color": "#15201b14", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" } },
    "2": { "$value": { "color": "#15201b1f", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px" } },
    "3": { "$value": { "color": "#15201b29", "offsetX": "0px", "offsetY": "12px", "blur": "28px", "spread": "-6px" } },
    "tonal": {
      "$type": "string",
      "1": { "$value": "color-mix(in srgb, {color.primitive.jade.500} 4%, {color.primitive.ink.0})" },
      "2": { "$value": "color-mix(in srgb, {color.primitive.jade.500} 8%, {color.primitive.ink.0})" },
      "3": { "$value": "color-mix(in srgb, {color.primitive.jade.500} 12%, {color.primitive.ink.0})" }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.42 },
    "muted": { "$value": 0.64 },
    "scrim": { "$value": 0.58 },
    "pattern": { "$value": 0.09 },
    "full": { "$value": 1 }
  },
  "gradient": {
    "$type": "string",
    "courtyard-wash": {
      "$value": "radial-gradient(120% 90% at 12% 8%, #f7efd9 0%, #e8ebe9 42%, #d4eee5 100%)"
    },
    "lapis-veil": {
      "$value": "linear-gradient(155deg, #eef7fb 0%, #d4eee5 48%, #8fc9df 100%)"
    },
    "jade-depth": {
      "$value": "radial-gradient(90% 70% at 80% 20%, #83c7ae 0%, #206f58 55%, #12392f 100%)"
    }
  },
  "pattern": {
    "density": {
      "$type": "number",
      "quiet": { "$value": 0.35 },
      "balanced": { "$value": 0.6 },
      "rich": { "$value": 0.85 }
    },
    "cell": {
      "$type": "dimension",
      "sm": { "$value": { "value": 16, "unit": "px" } },
      "md": { "$value": { "value": 28, "unit": "px" } },
      "lg": { "$value": { "value": 44, "unit": "px" } }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": { "value": 0, "unit": "ms" } },
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "normal": { "$value": { "value": 220, "unit": "ms" } },
      "slow": { "$value": { "value": 360, "unit": "ms" } },
      "ceremonial": { "$value": { "value": 600, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0.16, 1, 0.3, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] },
      "emphasis": { "$value": [0.22, 1, 0.36, 1] }
    }
  },
  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "sticky": { "$value": 100 },
    "overlay": { "$value": 400 },
    "modal": { "$value": 500 },
    "toast": { "$value": 600 }
  },
  "size": {
    "$type": "dimension",
    "icon-sm": { "$value": { "value": 16, "unit": "px" } },
    "icon-md": { "$value": { "value": 20, "unit": "px" } },
    "icon-lg": { "$value": { "value": 24, "unit": "px" } },
    "control-sm": { "$value": { "value": 32, "unit": "px" } },
    "control-md": { "$value": { "value": 40, "unit": "px" } },
    "control-lg": { "$value": { "value": 48, "unit": "px" } },
    "content-sm": { "$value": { "value": 560, "unit": "px" } },
    "content-md": { "$value": { "value": 720, "unit": "px" } },
    "content-lg": { "$value": { "value": 1120, "unit": "px" } }
  },
  "logical": {
    "flow": {
      "$type": "string",
      "inline-start": { "$value": "inline-start" },
      "inline-end": { "$value": "inline-end" },
      "block-start": { "$value": "block-start" },
      "block-end": { "$value": "block-end" }
    },
    "icon": {
      "$type": "string",
      "directional-transform-ltr": { "$value": "none" },
      "directional-transform-rtl": { "$value": "scaleX(-1)" }
    },
    "text": {
      "$type": "string",
      "align-start": { "$value": "start" },
      "align-end": { "$value": "end" }
    }
  },
  "theme": {
    "light": {
      "color": {
        "$type": "color",
        "background": { "$value": "{color.primitive.ink.50}" },
        "surface": { "$value": "{color.primitive.ink.0}" },
        "surface-subtle": { "$value": "{color.primitive.ink.100}" },
        "text": { "$value": "{color.primitive.ink.900}" },
        "text-muted": { "$value": "{color.primitive.ink.500}" },
        "border": { "$value": "{color.primitive.ink.300}" },
        "primary": { "$value": "{color.primitive.jade.600}" },
        "primary-hover": { "$value": "{color.primitive.jade.700}" },
        "on-primary": { "$value": "{color.primitive.ink.0}" },
        "secondary": { "$value": "{color.primitive.azure.700}" },
        "accent": { "$value": "{color.primitive.saffron.600}" },
        "focus": { "$value": "{color.primitive.azure.500}" },
        "danger": { "$value": "{color.primitive.clay.700}" },
        "on-danger": { "$value": "{color.primitive.ink.0}" },
        "selection": { "$value": "{color.primitive.jade.100}" },
        "scrim": { "$value": "#0a110e94" }
      }
    },
    "dark": {
      "color": {
        "$type": "color",
        "background": { "$value": "{color.primitive.ink.950}" },
        "surface": { "$value": "{color.primitive.ink.900}" },
        "surface-subtle": { "$value": "{color.primitive.ink.700}" },
        "text": { "$value": "{color.primitive.ink.50}" },
        "text-muted": { "$value": "{color.primitive.ink.300}" },
        "border": { "$value": "{color.primitive.ink.500}" },
        "primary": { "$value": "{color.primitive.jade.300}" },
        "primary-hover": { "$value": "{color.primitive.jade.100}" },
        "on-primary": { "$value": "{color.primitive.jade.900}" },
        "secondary": { "$value": "{color.primitive.azure.300}" },
        "accent": { "$value": "{color.primitive.saffron.200}" },
        "focus": { "$value": "{color.primitive.azure.300}" },
        "danger": { "$value": "{color.primitive.clay.300}" },
        "on-danger": { "$value": "{color.primitive.clay.900}" },
        "selection": { "$value": "{color.primitive.jade.700}" },
        "scrim": { "$value": "#000000b8" }
      }
    },
    "highContrast": {
      "color": {
        "$type": "color",
        "background": { "$value": "#000000" },
        "surface": { "$value": "#000000" },
        "surface-subtle": { "$value": "#171717" },
        "text": { "$value": "#ffffff" },
        "text-muted": { "$value": "#ffffff" },
        "border": { "$value": "#ffffff" },
        "primary": { "$value": "#62f5ba" },
        "primary-hover": { "$value": "#ffffff" },
        "on-primary": { "$value": "#000000" },
        "secondary": { "$value": "#8fddff" },
        "accent": { "$value": "#ffd65c" },
        "focus": { "$value": "#ffd65c" },
        "danger": { "$value": "#ff9c86" },
        "on-danger": { "$value": "#000000" },
        "selection": { "$value": "#195847" },
        "scrim": { "$value": "#000000e6" }
      }
    }
  }
}
